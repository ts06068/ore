{
  "name": "@ore/sdk",
  "version": "0.6.0-rc.3",
  "description": "Typed client for the self-hosted ORE retrieval agent",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:local": "npm run build && npm pack --pack-destination artifacts"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
