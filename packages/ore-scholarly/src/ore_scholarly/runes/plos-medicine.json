{
  "schema_version": "ore.rune/v0",
  "protocol_version": "0.2.0",
  "inputs": {
    "publication_window": {
      "basis": "issue_date",
      "from": "2006-01-01",
      "until_exclusive": "2026-01-01"
    },
    "article_scope": "primary_original_research",
    "archive_url": "https://journals.plos.org/plosmedicine/volume"
  },
  "instructions": "Build the issue inventory from the official archive. Reconcile each issue table of contents with database metadata. Use the publisher article type and abstract to classify primary original research; mark ambiguous types needs_review. Locate the main published PDF and every declared supplementary object. Preserve each format, file identity, license, source, version and parent relationship. Record missing, inaccessible and uninspected items separately. If the site differs from this context, inspect its current page and revise the plan without weakening the contract. Never infer complete coverage from a search-result count. Use executor-provided snapshot_id values from fetch or browser observations. Seal each locked issue with seal_issue using profile plos-medicine.issue.v1, then seal each article with seal_article using plos-medicine.article.v1. Download only minted candidate_id and requirement_id pairs for the matching registered article. An unrecognized template, incomplete attachment listing, unresolved type, unavailable source or missing final-version evidence remains an audit gap. Do not treat an LLM-declared inventory count as a sealed denominator.",
  "agent": {
    "controller": "llm",
    "model_selection": "runtime_config",
    "planning": "adaptive_with_contract",
    "tools": [
      "inventory",
      "api",
      "http",
      "browser",
      "computer",
      "artifact",
      "delegate"
    ]
  },
  "access_profile_ref": "local:approved-journal-access",
  "scope": {
    "origins": [
      "https://journals.plos.org"
    ],
    "asset_origins": [],
    "article_versions": [
      "published_version"
    ],
    "artifact_roles": [
      "main_pdf",
      "supplement"
    ],
    "collection_kind": "journal",
    "coverage_schema": "ore.coverage/v1",
    "coverage_profiles": {
      "issue": "plos-medicine.issue.v1",
      "article": "plos-medicine.article.v1"
    },
    "browser_support_origins": [
      "https://challenges.cloudflare.com"
    ]
  },
  "milestones": [
    {
      "id": "inventory",
      "requires": [],
      "evidence": "collection_and_resource_inventory"
    },
    {
      "id": "classify",
      "requires": [
        "inventory"
      ],
      "evidence": "eligibility_with_source_label"
    },
    {
      "id": "collect",
      "requires": [
        "classify"
      ],
      "evidence": "main_and_supplement_observations"
    },
    {
      "id": "audit",
      "requires": [
        "collect"
      ],
      "evidence": "verified_artifacts_and_unresolved_items"
    }
  ],
  "checks": [
    "inventory_reconciled_with_official_toc",
    "included_resources_have_main_pdf_status",
    "included_resources_have_supplement_discovery_status",
    "article_version_and_license_recorded",
    "sealed_issue_identity_manifest",
    "sealed_article_asset_manifests",
    "published_version_evidence",
    "zero_unresolved_required_assets"
  ],
  "limits": {
    "max_agent_workers": 5,
    "publisher_group_concurrency": 1,
    "origin_min_interval_seconds": 3,
    "transient_retries": 3,
    "agent_actions_per_resource": 30,
    "agent_seconds_per_resource": 300,
    "job_budget_ref": "local:research-pilot-budget"
  },
  "on_challenge": {
    "policy_version": 2,
    "mode": "auto",
    "adaptive": true,
    "max_attempts_per_episode": 3,
    "max_elapsed_seconds": 120,
    "hard_max_attempts": 6,
    "hard_max_elapsed_seconds": 300,
    "budget_scope": "origin_and_auth_context",
    "counter_storage": "orbit",
    "on_exhausted": "awaiting_user",
    "handoff": "same_browser_session"
  },
  "on_access_denied": "record_access_required",
  "verification": {
    "live_verified": false,
    "selector_validation": "agent_observation_required",
    "status": "context_pack_not_live_execution_evidence"
  },
  "protocol_id": "journal.plos-medicine",
  "context": {
    "journal_title": "PLOS Medicine",
    "issns": [
      "1549-1277",
      "1549-1676"
    ],
    "first_publication_year": 2004,
    "title_scope": "main_journal_only",
    "publisher_section_labels": [
      "Research Article"
    ],
    "article_type_map": {
      "Research Article": "candidate_original_research"
    },
    "ambiguous_type": "needs_review",
    "excluded_study_types": [
      "systematic_review",
      "meta_analysis",
      "editorial",
      "narrative_review"
    ],
    "notes": "Supporting Information links identify supplements, which may be DOCX/XLSX/ZIP as well as PDF. Research Article is a publisher section, not proof of primary research.",
    "sources": [
      "pubmed",
      "crossref"
    ],
    "resolvers": [
      "unpaywall",
      "pmc"
    ],
    "artifact_discovery": {
      "main": [
        "citation_pdf_url",
        "publisher PDF action"
      ],
      "supplement": [
        "publisher supplementary/supporting-information section",
        "JATS supplementary-material links"
      ],
      "unlisted_media": "media_unknown; do not relabel all images as supplements"
    },
    "completion_boundary": "Publisher TOC reconciliation plus individual artifact observations; empty browser section alone is not proof of absence.",
    "asset_origin_policy": "Discover asset origins from observed links and authorize through the mission scope before retrieval; no blanket CDN wildcard.",
    "pilot": {
      "year": 2025,
      "volume": "22",
      "issue": "1",
      "sample_doi": "10.1371/journal.pmed.1004493",
      "expected_example_roles": [
        "main_pdf",
        "supplement"
      ],
      "live_download_verified": false
    }
  },
  "completeness": "systematic",
  "coverage_schema": "ore.coverage/v1",
  "authority_order": [
    "journal",
    "publisher",
    "pmc"
  ]
}
